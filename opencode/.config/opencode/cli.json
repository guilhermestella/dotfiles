{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "keybinds": {
    "leader": "ctrl+w",
    "app.exit": "ctrl+d",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.undo": [],
    "session.list": "<leader>space",
    "session.line.up": "ctrl+y",
    "session.line.down": "ctrl+e",
    "session.new": "<leader>n",
    "session.tab.next": "alt+k",
    "session.tab.previous": "alt+j",
    "session.tab.close": ["<leader>q", "<leader>c"],
    "session.tab.reopen": "<leader>u"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide",
    "submit_scroll": "bottom",
    "grouping": "none",
    "verbosity": "low"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "animations": true
}
